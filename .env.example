// Document local environment variables without including real secrets.
LISTEN_ADDR=:8080
DATABASE_PATH=../data/dazzled.db
WEB_DIR=../frontend/out
API_ORIGIN=http://localhost:8080
# Set true only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Optional stable 32+ byte signing key; generate with: openssl rand -hex 32
GAME_TOKEN_SECRET=
